# PostgreSQL connection (required)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Public canonical URL used for sitemap / Open Graph (can also be set in Admin → Settings → SEO)
NEXT_PUBLIC_SITE_URL=

# Optional: require a one-time token on the /admin/setup screen when creating the ceo@mrhome.com account.
# Strongly recommended in production so only you can complete the initial secure setup.
ADMIN_SETUP_TOKEN=
